APP_NAME=Gamification Service API
APP_VERSION=1.0.0
DEBUG=true
API_PORT=9004

# PostgreSQL
POSTGRES_HOST=postgres
POSTGRES_PORT=5432
POSTGRES_USER=gamification_user
POSTGRES_PASSWORD=gamification_password
POSTGRES_DB=gamification_db

# Redis
REDIS_URL=redis://redis:6379/0

# Auth (JWT secret del platform-portal-cc)
JWT_SECRET_KEY=test-secret-key
JWT_ALGORITHM=HS256

# Gamification rules
POINTS_TO_COINS_RATE=100
